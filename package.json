{
  "name": "icon-forge",
  "version": "1.0.3",
  "description": "Build-time Iconify icon extraction for Vite and Vue.",
  "type": "module",
  "license": "MIT",
  "files": [
    "src",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./src/core.d.ts",
      "default": "./src/core.js"
    },
    "./vite": {
      "types": "./src/vite.d.ts",
      "default": "./src/vite.js"
    },
    "./vue": {
      "types": "./src/vue.d.ts",
      "default": "./src/vue.js"
    }
  },
  "bin": {
    "icon-forge": "./bin/icon-forge.js"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check src/core.js && node --check src/vite.js && node --check src/vue.js && node --check src/size.js && node --check bin/icon-forge.js"
  },
  "dependencies": {
    "@iconify/utils": "^3.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "vue": "^3.2.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  }
}
